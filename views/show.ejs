<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Notes Maker App</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

    <!-- Highlight.js Dark Theme CSS for Code Blocks -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/tokyo-night-dark.min.css"
    />

    <!-- Custom styling to ensure markdown elements look great inside Tailwind -->
    <style>
      #note-content pre {
        background-color: #18181b; /* zinc-900 */
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin-top: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #27272a; /* zinc-800 */
      }
      #note-content code {
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }
      #note-content p {
        margin-bottom: 0.75rem;
      }
      #note-content ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
      }
      #note-content ol {
        list-style-type: decimal;
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
      }
    </style>
  </head>

  <body class="bg-zinc-900 text-white">
    <div class="min-h-screen w-full px-4 py-8 sm:px-8 max-w-4xl mx-auto">
      <!-- Navigation / Back Button -->
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors"
        >
          ← Back to All Notes
        </a>
      </div>

      <!-- Note Detail Card -->
      <div
        class="bg-zinc-800 p-6 sm:p-8 rounded-xl shadow-lg border border-zinc-700"
      >
        <!-- Title -->
        <h1
          class="text-2xl sm:text-3xl font-bold text-blue-400 mb-6 break-words"
        >
          <%= title %>
        </h1>

        <hr class="border-zinc-700 mb-6" />

        <!-- Message Content (Markdown & Code Highlighted via JS) -->
        <div
          id="note-content"
          class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-8 break-words"
        >
          <%= message %>
        </div>

        <!-- Action Buttons -->
        <div
          class="flex flex-wrap items-center gap-4 pt-4 border-t border-zinc-700"
        >
          <a
            href="/edit/<%= encodeURIComponent(filename) %>"
            class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2 px-5 rounded-lg transition duration-300 text-sm"
          >
            Edit Note
          </a>

          <form
            action="/delete/<%= encodeURIComponent(filename) %>"
            method="POST"
            onsubmit="
              return confirm('Are you sure you want to delete this note?');
            "
          >
            <button
              type="submit"
              class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-5 rounded-lg transition duration-300 text-sm cursor-pointer"
            >
              Delete Note
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Marked.js & Highlight.js Scripts -->

    <!-- Highlight.js Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

    <script>
      // Get the raw message passed from backend
      const rawMessage = `<%- JSON.stringify(message) %>`;
      const container = document.getElementById("note-content");

      // Check if the message contains code blocks or markdown, else render with preserved line breaks
      if (rawMessage.includes("```")) {
        // If it has markdown code blocks, use marked.js
        container.innerHTML = marked.parse(JSON.parse(rawMessage));
        hljs.highlightAll();
      } else {
        // Otherwise, render as clean plain text preserving all spaces and newlines!
        container.style.whiteSpace = "pre-wrap";
        container.textContent = JSON.parse(rawMessage);
      }
    </script>
  </body>
</html>
